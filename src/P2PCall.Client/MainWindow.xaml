<Window x:Class="P2PCall.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:P2PCall.Client.Controls"
        Title="P2P Call" Height="640" Width="1080" MinWidth="760" MinHeight="480"
        Language="pt-BR"
        Background="#16181D" Foreground="#E6E8EC" FontFamily="Segoe UI" FontSize="14"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Rótulo de campo: Label (e não TextBlock) para ter tecla de acesso Alt+letra ligada ao campo. -->
        <Style TargetType="a11y:AccessibleLabel">
            <Setter Property="Foreground" Value="#B4BAC4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Background" Value="#22252C" />
            <Setter Property="Foreground" Value="#E6E8EC" />
            <Setter Property="BorderBrush" Value="#5A6170" />
            <Setter Property="CaretBrush" Value="#E6E8EC" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#8AB4FF" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,5" />
        </Style>

        <!-- Botões com foco bem visível (anel claro) e estado "ativado" com contraste alto. -->
        <Style x:Key="ActionButton" TargetType="ButtonBase">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="#2D3340" />
            <Setter Property="Foreground" Value="#F2F4F7" />
            <Setter Property="BorderBrush" Value="#5A6170" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A4252" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9B1C1C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F87171" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B919C" />
                                <Setter TargetName="Bd" Property="Background" Value="#22252C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="a11y:AccessibleButton" BasedOn="{StaticResource ActionButton}" />
        <Style TargetType="a11y:AccessibleToggleButton" BasedOn="{StaticResource ActionButton}" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Controles -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel AutomationProperties.Name="Controles da chamada">
                <TextBlock Text="Chamada P2P" FontSize="22" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1" />

                <a11y:AccessibleLabel x:Name="ServerLabel" Content="Ser_vidor de sinalização" Target="{Binding ElementName=ServerInput}" />
                <TextBox x:Name="ServerInput" Text="https://voz.tempsharing.com.br"
                         AutomationProperties.Name="Servidor de sinalização"
                         AutomationProperties.LabeledBy="{Binding ElementName=ServerLabel}"
                         AutomationProperties.HelpText="Endereço do servidor que conecta os participantes. Atalho: Alt+V." />

                <a11y:AccessibleLabel x:Name="RoomLabel" Content="_Sala" Target="{Binding ElementName=RoomInput}" />
                <TextBox x:Name="RoomInput" KeyDown="RoomInput_KeyDown" TextChanged="RoomInput_TextChanged"
                         AutomationProperties.Name="Nome da sala"
                         AutomationProperties.LabeledBy="{Binding ElementName=RoomLabel}"
                         AutomationProperties.IsRequiredForForm="True"
                         AutomationProperties.HelpText="Obrigatório. Digite o nome ou cole o link da sala. Pressione Enter para entrar. Atalho: Alt+S." />

                <a11y:AccessibleLabel x:Name="MicLabel" Content="Mi_crofone" Target="{Binding ElementName=MicSelect}" />
                <ComboBox x:Name="MicSelect" DisplayMemberPath="Name" SelectionChanged="MicSelect_SelectionChanged"
                          AutomationProperties.Name="Microfone"
                          AutomationProperties.LabeledBy="{Binding ElementName=MicLabel}"
                          AutomationProperties.HelpText="Pode ser trocado durante a chamada. Atalho: Alt+C." />

                <a11y:AccessibleLabel x:Name="QualityLabel" Content="_Qualidade de envio (Opus)" Target="{Binding ElementName=QualitySelect}" />
                <ComboBox x:Name="QualitySelect" SelectionChanged="QualitySelect_SelectionChanged"
                          AutomationProperties.Name="Qualidade de envio"
                          AutomationProperties.LabeledBy="{Binding ElementName=QualityLabel}"
                          AutomationProperties.HelpText="Taxa de bits do seu microfone. Atalho: Alt+Q.">
                    <ComboBoxItem Content="32 kbps (economia)" Tag="32000" />
                    <ComboBoxItem Content="64 kbps (voz)" Tag="64000" />
                    <ComboBoxItem Content="128 kbps (alta)" Tag="128000" IsSelected="True" />
                    <ComboBoxItem Content="256 kbps (estúdio)" Tag="256000" />
                    <ComboBoxItem Content="510 kbps (máxima)" Tag="510000" />
                </ComboBox>

                <a11y:AccessibleButton x:Name="BtnStart" Content="_Entrar na sala" Margin="0,18,0,0"
                        Background="#1F5FD6" BorderBrush="#6E9BF5" Click="BtnStart_Click"
                        AutomationProperties.HelpText="Atalho: Alt+E." />
                <a11y:AccessibleToggleButton x:Name="BtnMute" Content="Silenciar _Microfone" IsEnabled="False" Checked="BtnMute_Toggled" Unchecked="BtnMute_Toggled"
                              AutomationProperties.Name="Silenciar microfone"
                              AutomationProperties.AcceleratorKey="Ctrl+M"
                              AutomationProperties.HelpText="Quando pressionado, seu microfone está silenciado. Atalhos: Ctrl+M ou Alt+M." />
                <a11y:AccessibleToggleButton x:Name="BtnShare" Content="Compartilhar _Tela" IsEnabled="False" Checked="BtnShare_Toggled" Unchecked="BtnShare_Toggled"
                              AutomationProperties.Name="Compartilhar tela"
                              AutomationProperties.HelpText="Quando pressionado, sua tela principal e o áudio do PC estão sendo enviados. Atalho: Alt+T." />
                <a11y:AccessibleToggleButton x:Name="BtnRecord" Content="_Gravar Chamada" IsEnabled="False" Checked="BtnRecord_Toggled" Unchecked="BtnRecord_Toggled"
                              AutomationProperties.Name="Gravar chamada"
                              AutomationProperties.HelpText="Quando pressionado, a chamada está sendo gravada. Solte para salvar o arquivo. Atalho: Alt+G." />
                <a11y:AccessibleButton x:Name="BtnCopyLink" Content="Copiar _link da sala" IsEnabled="False" Click="BtnCopyLink_Click"
                        AutomationProperties.HelpText="Copia o link da sala para a área de transferência. Funciona no navegador e neste aplicativo. Atalho: Alt+L." />
                <a11y:AccessibleButton x:Name="BtnLeave" Content="Sai_r da sala" IsEnabled="False" Click="BtnLeave_Click"
                        AutomationProperties.HelpText="Atalho: Alt+R." />

                <!-- Regiões "ao vivo": o leitor de tela anuncia as mudanças sem mover o foco. -->
                <Border Margin="0,18,0,0" Padding="10" CornerRadius="6" Background="#1E2128">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Text="Carregando dispositivos..." TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.HelpText="Status da chamada" />
                        <TextBlock x:Name="ParticipantsText" Margin="0,6,0,0" Foreground="#B4BAC4" FontSize="13"
                                   Text="Participantes conectados: 0"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Telas compartilhadas -->
        <Border Grid.Column="2" Background="#0F1115" CornerRadius="8">
            <Grid>
                <TextBlock x:Name="NoScreensText" Text="Nenhuma tela compartilhada" Foreground="#8B919C"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ItemsControl x:Name="ScreensList" Focusable="False"
                              AutomationProperties.Name="Telas compartilhadas">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Focável para que quem navega pelo teclado também encontre cada tela. -->
                            <Border Margin="6" Focusable="True" BorderThickness="2" BorderBrush="Transparent"
                                    AutomationProperties.Name="{Binding Label}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="BorderBrush" Value="#FFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Image Source="{Binding Bitmap}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           AutomationProperties.Name="{Binding Label}" />
                                    <Border Background="#CC000000" CornerRadius="4" Padding="6,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                        <TextBlock Text="{Binding Label}" FontSize="13" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</Window>
