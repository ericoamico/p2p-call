<Window x:Class="P2PCall.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="P2P Call" Height="640" Width="1080" MinWidth="760" MinHeight="480"
        Background="#16181D" Foreground="#E6E8EC" FontFamily="Segoe UI" FontSize="14"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#9AA1AD" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Background" Value="#22252C" />
            <Setter Property="Foreground" Value="#E6E8EC" />
            <Setter Property="BorderBrush" Value="#343844" />
            <Setter Property="CaretBrush" Value="#E6E8EC" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,5" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="#2D3340" />
            <Setter Property="Foreground" Value="#E6E8EC" />
            <Setter Property="BorderBrush" Value="#3B4252" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Controles -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Chamada P2P" FontSize="22" FontWeight="SemiBold" />

                <TextBlock Style="{StaticResource Label}" Text="Servidor de sinalização" />
                <TextBox x:Name="ServerInput" Text="https://voz.tempsharing.com.br" />

                <TextBlock Style="{StaticResource Label}" Text="Sala" />
                <TextBox x:Name="RoomInput" KeyDown="RoomInput_KeyDown" />

                <TextBlock Style="{StaticResource Label}" Text="Microfone" />
                <ComboBox x:Name="MicSelect" DisplayMemberPath="Name" SelectionChanged="MicSelect_SelectionChanged" />

                <TextBlock Style="{StaticResource Label}" Text="Qualidade de envio (Opus)" />
                <ComboBox x:Name="QualitySelect" SelectionChanged="QualitySelect_SelectionChanged">
                    <ComboBoxItem Content="32 kbps (economia)" Tag="32000" />
                    <ComboBoxItem Content="64 kbps (voz)" Tag="64000" />
                    <ComboBoxItem Content="128 kbps (alta)" Tag="128000" IsSelected="True" />
                    <ComboBoxItem Content="256 kbps (estúdio)" Tag="256000" />
                    <ComboBoxItem Content="510 kbps (máxima)" Tag="510000" />
                </ComboBox>

                <Button x:Name="BtnStart" Content="Entrar na sala" Margin="0,18,0,0"
                        Background="#2F6FEB" BorderBrush="#2F6FEB" Click="BtnStart_Click" />
                <Button x:Name="BtnMute" Content="Silenciar Microfone" IsEnabled="False" Click="BtnMute_Click" />
                <Button x:Name="BtnShare" Content="Compartilhar Tela" IsEnabled="False" Click="BtnShare_Click" />
                <Button x:Name="BtnRecord" Content="Gravar Chamada" IsEnabled="False" Click="BtnRecord_Click" />
                <Button x:Name="BtnLeave" Content="Sair da sala" IsEnabled="False" Click="BtnLeave_Click" />

                <Border Margin="0,18,0,0" Padding="10" CornerRadius="6" Background="#1E2128">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Text="Carregando dispositivos..." TextWrapping="Wrap" />
                        <TextBlock x:Name="ParticipantsText" Margin="0,6,0,0" Foreground="#9AA1AD" FontSize="12"
                                   Text="Participantes conectados: 0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Telas compartilhadas -->
        <Border Grid.Column="2" Background="#0F1115" CornerRadius="8">
            <Grid>
                <TextBlock x:Name="NoScreensText" Text="Nenhuma tela compartilhada" Foreground="#5C6370"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ItemsControl x:Name="ScreensList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6">
                                <Image Source="{Binding Bitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border Background="#AA000000" CornerRadius="4" Padding="6,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                    <TextBlock Text="{Binding Label}" FontSize="12" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</Window>
